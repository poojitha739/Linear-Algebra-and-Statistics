% COLUMN AND NULL SPACE
% =================================================

\section{Column Space and Null Space}

% -------------------------------------------------
\begin{frame}[t,shrink=12]{16. Column Space}

The \textbf{column space} of a matrix $A$ is the span of its column vectors.

If

\[
A=
\begin{bmatrix}
|&|& &|\\
\mathbf{a}_1&\mathbf{a}_2&\cdots&\mathbf{a}_n\\
|&|& &|
\end{bmatrix},
\]

then

\[
\operatorname{Col}(A)
=
\operatorname{span}
\{\mathbf{a}_1,\mathbf{a}_2,\ldots,\mathbf{a}_n\}.
\]

\begin{itemize}
    \item The column space describes all possible outputs $A\mathbf{x}$.
    \item Its dimension is called the \textbf{rank} of $A$.
    \item Pivot columns provide a basis for the column space.
\end{itemize}

\end{frame}

% -------------------------------------------------
\begin{frame}[t,shrink=12]{17. Null Space}

The \textbf{null space} of $A$ is the set of vectors $\mathbf{x}$ satisfying

\[
A\mathbf{x}=\mathbf{0}.
\]

It is written as

\[
\operatorname{Null}(A)
=
\{\mathbf{x}:A\mathbf{x}=\mathbf{0}\}.
\]

\begin{block}{Interpretation}
The null space contains all input vectors that are mapped to the
zero vector by the transformation represented by $A$.
\end{block}

\begin{itemize}
    \item The null space is a vector space.
    \item Its dimension is called the \textbf{nullity}.
\end{itemize}

\end{frame}

% -------------------------------------------------
\begin{frame}[t,shrink=12]{18. Rank--Nullity Theorem}

For a matrix

\[
A\in\mathbb{R}^{m\times n},
\]

the rank--nullity theorem states

\[
\boxed{
\operatorname{rank}(A)
+
\operatorname{nullity}(A)
=
n
}
\]

where $n$ is the number of columns of $A$.

\begin{block}{Meaning}
\begin{itemize}
    \item Rank measures the number of independent output directions.
    \item Nullity measures the number of independent directions mapped
    to zero.
\end{itemize}
\end{block}

This theorem connects the column space and null space of a matrix.

\end{frame}

% =================================================
% NON-SQUARE MATRICES
% =================================================

\section{Non-Square Matrices}

% -------------------------------------------------
\begin{frame}[t,shrink=12]{19. Non-Square Matrices}

A matrix does not have to be square.

For example,

\[
A\in\mathbb{R}^{2\times3}
\]

has two rows and three columns.

Such a matrix represents a transformation

\[
T:\mathbb{R}^3\rightarrow\mathbb{R}^2.
\]

For

\[
\mathbf{x}\in\mathbb{R}^3,
\]

the product

\[
A\mathbf{x}
\]

produces a vector in $\mathbb{R}^2$.

\begin{block}{Key Idea}
Non-square matrices allow transformations between spaces
of different dimensions.
\end{block}

\end{frame}

% -------------------------------------------------
\begin{frame}[t,shrink=12]{20. Transformations Between Dimensions}

Consider

\[
A=
\begin{bmatrix}
1&0&2\\
0&1&1
\end{bmatrix}.
\]

Then

\[
A:
\mathbb{R}^3\rightarrow\mathbb{R}^2.
\]

For

\[
\mathbf{x}=
\begin{bmatrix}
x\\y\\z
\end{bmatrix},
\]

we obtain

\[
A\mathbf{x}
=
\begin{bmatrix}
x+2z\\
y+z
\end{bmatrix}.
\]

\begin{itemize}
    \item Three input coordinates are transformed into two output coordinates.
    \item Such transformations are common in dimensionality reduction
    and data representation.
\end{itemize}

\end{frame}

% =================================================
% DOT PRODUCT
% =================================================

\section{Dot Products and Duality}

% -------------------------------------------------
\begin{frame}[t,shrink=12]{21. Dot Product}

For

\[
\mathbf{u}=
\begin{bmatrix}
u_1\\u_2\\\vdots\\u_n
\end{bmatrix},
\qquad
\mathbf{v}=
\begin{bmatrix}
v_1\\v_2\\\vdots\\v_n
\end{bmatrix},
\]

the dot product is

\[
\mathbf{u}\cdot\mathbf{v}
=
\sum_{i=1}^{n}u_iv_i.
\]

For three dimensions,

\[
\mathbf{u}\cdot\mathbf{v}
=
u_1v_1+u_2v_2+u_3v_3.
\]

Geometrically,

\[
\mathbf{u}\cdot\mathbf{v}
=
\|\mathbf{u}\|\|\mathbf{v}\|\cos\theta.
\]

\end{frame}

% -------------------------------------------------
\begin{frame}[t,shrink=12]{22. Applications of the Dot Product}

The dot product can be used to determine the angle between vectors.

\[
\cos\theta
=
\frac{\mathbf{u}\cdot\mathbf{v}}
{\|\mathbf{u}\|\|\mathbf{v}\|}.
\]

\begin{block}{Orthogonality}
Two non-zero vectors are perpendicular when

\[
\mathbf{u}\cdot\mathbf{v}=0.
\]
\end{block}

Other applications include:

\begin{itemize}
    \item Projection of vectors
    \item Distance calculations
    \item Computer graphics
    \item Machine learning similarity measures
    \item Physics and mechanics
\end{itemize}

\end{frame}

% -------------------------------------------------
\begin{frame}[t,shrink=12]{23. Duality}

The dot product creates a connection between vectors and linear
functions.

For a fixed vector $\mathbf{v}$, define

\[
f(\mathbf{x})
=
\mathbf{v}^{T}\mathbf{x}.
\]

This function maps

\[
\mathbb{R}^n\rightarrow\mathbb{R}.
\]

Thus a vector can define a linear functional.

\begin{block}{Concept}
The correspondence between vectors and linear functionals is an
important idea behind \textbf{duality} in linear algebra.
\end{block}

In matrix notation,

\[
\mathbf{v}^{T}\mathbf{x}
=
v_1x_1+\cdots+v_nx_n.
\]

\end{frame}

% =================================================
% CROSS PRODUCT
% =================================================

\section{Cross Products}

% -------------------------------------------------
\begin{frame}[t,shrink=12]{24. Cross Product}

The cross product is defined for vectors in $\mathbb{R}^3$.

For

\[
\mathbf{u}=(u_1,u_2,u_3)
\]

and

\[
\mathbf{v}=(v_1,v_2,v_3),
\]

\[
\mathbf{u}\times\mathbf{v}
=
\begin{bmatrix}
u_2v_3-u_3v_2\\
u_3v_1-u_1v_3\\
u_1v_2-u_2v_1
\end{bmatrix}.
\]

The result is a vector perpendicular to both
$\mathbf{u}$ and $\mathbf{v}$.

\end{frame}

% -------------------------------------------------
\begin{frame}[t,shrink=12]{25. Properties of Cross Product}

The cross product satisfies

\[
\mathbf{u}\times\mathbf{v}
=
-(\mathbf{v}\times\mathbf{u}).
\]

Therefore, it is not commutative.

Also,

\[
\mathbf{u}\times\mathbf{u}
=
\mathbf{0}.
\]

Its magnitude is

\[
\|\mathbf{u}\times\mathbf{v}\|
=
\|\mathbf{u}\|
\|\mathbf{v}\|
\sin\theta.
\]

\begin{block}{Geometric Meaning}
The magnitude represents the area of the parallelogram formed by
$\mathbf{u}$ and $\mathbf{v}$.
\end{block}

\end{frame}

% -------------------------------------------------
\begin{frame}[t,shrink=12]{26. Cross Product and Linear Transformations}

The cross product can be expressed using a skew-symmetric matrix.

For

\[
\mathbf{u}
=
\begin{bmatrix}
u_1\\u_2\\u_3
\end{bmatrix},
\]

define

\[
[\mathbf{u}]_{\times}
=
\begin{bmatrix}
0&-u_3&u_2\\
u_3&0&-u_1\\
-u_2&u_1&0
\end{bmatrix}.
\]

Then

\[
\boxed{
\mathbf{u}\times\mathbf{v}
=
[\mathbf{u}]_{\times}\mathbf{v}
}
\]

This converts the cross-product operation into matrix multiplication.

\end{frame}

% =================================================
% CRAMER'S RULE
% =================================================

\section{Cramer's Rule}

% -------------------------------------------------
\begin{frame}[t,shrink=12]{27. Cramer's Rule}

Cramer's rule provides a method for solving a system of linear
equations using determinants.

For

\[
A\mathbf{x}=\mathbf{b},
\]

where $A$ is an invertible $n\times n$ matrix,

\[
x_i
=
\frac{\det(A_i)}{\det(A)}.
\]

Here $A_i$ is obtained by replacing the $i$-th column of $A$
with the vector $\mathbf{b}$.

\begin{block}{Condition}
Cramer's rule can be applied only when

\[
\det(A)\neq0.
\]
\end{block}

\end{frame}

% -------------------------------------------------
\begin{frame}[t,shrink=12]{28. Example of Cramer's Rule}

Consider

\[
2x+y=5
\]

\[
x-y=1.
\]

The coefficient matrix is

\[
A=
\begin{bmatrix}
2&1\\
1&-1
\end{bmatrix}.
\]

Therefore,

\[
\det(A)
=
(2)(-1)-(1)(1)
=-3.
\]

For $x$,

\[
A_x=
\begin{bmatrix}
5&1\\
1&-1
\end{bmatrix},
\qquad
x=
\frac{\det(A_x)}{\det(A)}.
\]

Similarly,

\[
y=
\frac{\det(A_y)}{\det(A)}.
\]

Thus Cramer's rule converts the solution of equations into determinant
calculations.

\end{frame}

% =================================================
% CHANGE OF BASIS
% =================================================

\section{Change of Basis}

% -------------------------------------------------
\begin{frame}[t,shrink=12]{29. Change of Basis}

A vector can have different coordinate representations depending on
the chosen basis.

Suppose

\[
B=\{\mathbf{b}_1,\mathbf{b}_2,\ldots,\mathbf{b}_n\}
\]

is a basis.

Then

\[
\mathbf{x}
=
c_1\mathbf{b}_1+
c_2\mathbf{b}_2+\cdots+c_n\mathbf{b}_n.
\]

The coordinate vector relative to basis $B$ is

\[
[\mathbf{x}]_B
=
\begin{bmatrix}
c_1\\c_2\\\vdots\\c_n
\end{bmatrix}.
\]

\begin{block}{Important}
The geometric vector remains the same, but its coordinate description
changes with the basis.
\end{block}

\end{frame}

% -------------------------------------------------
\begin{frame}[t,shrink=12]{30. Change-of-Basis Matrix}

Let

\[
P=
\begin{bmatrix}
|&|&&|\\
\mathbf{b}_1&\mathbf{b}_2&\cdots&\mathbf{b}_n\\
|&|&&|
\end{bmatrix}.
\]

Then

\[
\mathbf{x}=P[\mathbf{x}]_B.
\]

Therefore,

\[
[\mathbf{x}]_B=P^{-1}\mathbf{x}.
\]

For two bases $B$ and $C$,

\[
[\mathbf{x}]_C
=
P_{C\leftarrow B}
[\mathbf{x}]_B.
\]

\begin{block}{Applications}
Change of basis is important in:
\begin{itemize}
    \item Computer graphics
    \item Robotics
    \item Physics
    \item Coordinate transformations
\end{itemize}
\end{block}

\end{frame}

