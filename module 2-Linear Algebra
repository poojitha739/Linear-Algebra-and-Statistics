\section{Vectors and Coordinate Systems}

% -------------------------------------------------
\begin{frame}[t,shrink=12]{1. Vectors}

\begin{block}{Definition}
A \textbf{vector} is a mathematical object that has both
magnitude and direction.
\end{block}

\begin{itemize}
    \item Vectors are commonly represented as ordered lists of numbers.
    \item A two-dimensional vector belongs to $\mathbb{R}^2$.
    \item A three-dimensional vector belongs to $\mathbb{R}^3$.
\end{itemize}

\[
\mathbf{v}
=
\begin{bmatrix}
v_1\\
v_2\\
\vdots\\
v_n
\end{bmatrix}
\in \mathbb{R}^n
\]

\begin{exampleblock}{Example}
\[
\mathbf{v}=
\begin{bmatrix}
3\\
4
\end{bmatrix}
\]

Its magnitude is

\[
\|\mathbf{v}\|=\sqrt{3^2+4^2}=5.
\]
\end{exampleblock}

\end{frame}

% -------------------------------------------------
\begin{frame}[t,shrink=12]{2. Coordinate System}

A coordinate system provides a reference framework for representing
points and vectors.

\begin{itemize}
    \item In $\mathbb{R}^2$, two perpendicular axes are generally used.
    \item In $\mathbb{R}^3$, three mutually perpendicular axes are used.
    \item The origin is represented by the zero vector.
\end{itemize}

\[
\mathbf{v}
=
x\mathbf{i}+y\mathbf{j}
\]

For three dimensions,

\[
\mathbf{v}
=
x\mathbf{i}+y\mathbf{j}+z\mathbf{k}
\]

where

\[
\mathbf{i}=
\begin{bmatrix}
1\\0\\0
\end{bmatrix},
\quad
\mathbf{j}=
\begin{bmatrix}
0\\1\\0
\end{bmatrix},
\quad
\mathbf{k}=
\begin{bmatrix}
0\\0\\1
\end{bmatrix}.
\]

\end{frame}

% -------------------------------------------------
\begin{frame}[t,shrink=12]{3. Vector Addition}

Two vectors of the same dimension can be added component by component.

\[
\mathbf{u}
=
\begin{bmatrix}
u_1\\u_2\\\vdots\\u_n
\end{bmatrix},
\qquad
\mathbf{v}
=
\begin{bmatrix}
v_1\\v_2\\\vdots\\v_n
\end{bmatrix}
\]

Then

\[
\mathbf{u}+\mathbf{v}
=
\begin{bmatrix}
u_1+v_1\\
u_2+v_2\\
\vdots\\
u_n+v_n
\end{bmatrix}.
\]

\begin{exampleblock}{Example}
\[
\begin{bmatrix}
2\\3
\end{bmatrix}
+
\begin{bmatrix}
4\\1
\end{bmatrix}
=
\begin{bmatrix}
6\\4
\end{bmatrix}.
\]
\end{exampleblock}

\begin{itemize}
    \item Vector addition is commutative:
    $\mathbf{u}+\mathbf{v}=\mathbf{v}+\mathbf{u}$.
    \item It is also associative.
\end{itemize}

\end{frame}

% -------------------------------------------------
\begin{frame}[t,shrink=12]{4. Scalar Multiplication}

Multiplication of a vector by a scalar changes its magnitude and,
depending on the sign, its direction.

For scalar $c$,

\[
c\mathbf{v}
=
c
\begin{bmatrix}
v_1\\v_2\\\vdots\\v_n
\end{bmatrix}
=
\begin{bmatrix}
cv_1\\cv_2\\\vdots\\cv_n
\end{bmatrix}.
\]

\begin{exampleblock}{Example}
\[
3
\begin{bmatrix}
2\\-1
\end{bmatrix}
=
\begin{bmatrix}
6\\-3
\end{bmatrix}.
\]
\end{exampleblock}

\begin{itemize}
    \item $c>1$: magnitude increases.
    \item $0<c<1$: magnitude decreases.
    \item $c<0$: direction is reversed.
    \item $c=0$: result is the zero vector.
\end{itemize}

\end{frame}

% =================================================
% LINEAR COMBINATIONS
% =================================================

\section{Linear Combinations, Span and Basis}

% -------------------------------------------------
\begin{frame}[t,shrink=12]{5. Linear Combinations}

A \textbf{linear combination} is formed by multiplying vectors by
scalars and adding the resulting vectors.

Given vectors

\[
\mathbf{v}_1,\mathbf{v}_2,\ldots,\mathbf{v}_k,
\]

a linear combination is

\[
c_1\mathbf{v}_1+
c_2\mathbf{v}_2+
\cdots+
c_k\mathbf{v}_k.
\]

where $c_1,c_2,\ldots,c_k$ are scalars.

\begin{exampleblock}{Example}
Let

\[
\mathbf{v}_1=
\begin{bmatrix}1\\0\end{bmatrix},
\quad
\mathbf{v}_2=
\begin{bmatrix}0\\1\end{bmatrix}.
\]

Then

\[
3\mathbf{v}_1+2\mathbf{v}_2
=
\begin{bmatrix}3\\2\end{bmatrix}.
\]
\end{exampleblock}

\end{frame}

% -------------------------------------------------
\begin{frame}[t,shrink=12]{6. Span of Vectors}

The \textbf{span} of a set of vectors is the collection of all possible
linear combinations of those vectors.

\[
\operatorname{span}
\{\mathbf{v}_1,\mathbf{v}_2,\ldots,\mathbf{v}_k\}
\]

contains every vector that can be represented as

\[
c_1\mathbf{v}_1+
c_2\mathbf{v}_2+\cdots+c_k\mathbf{v}_k.
\]

\begin{block}{Geometric Interpretation}
The span describes the space that can be reached using the given
vectors and scalar multiplication.
\end{block}

\begin{itemize}
    \item One non-zero vector in $\mathbb{R}^2$ spans a line.
    \item Two linearly independent vectors in $\mathbb{R}^2$ span a plane.
    \item Three independent vectors in $\mathbb{R}^3$ span $\mathbb{R}^3$.
\end{itemize}

\end{frame}

% -------------------------------------------------
\begin{frame}[t,shrink=12]{7. Basis Vectors}

A \textbf{basis} is a set of vectors that:

\begin{enumerate}
    \item spans the vector space, and
    \item is linearly independent.
\end{enumerate}

The standard basis of $\mathbb{R}^2$ is

\[
\mathbf{e}_1=
\begin{bmatrix}
1\\0
\end{bmatrix},
\qquad
\mathbf{e}_2=
\begin{bmatrix}
0\\1
\end{bmatrix}.
\]

Every vector

\[
\mathbf{v}=
\begin{bmatrix}
x\\y
\end{bmatrix}
\]

can be written as

\[
\mathbf{v}=x\mathbf{e}_1+y\mathbf{e}_2.
\]

\begin{block}{Key Idea}
A basis provides a coordinate system for representing vectors.
\end{block}

\end{frame}

% -------------------------------------------------
\begin{frame}[t,shrink=12]{8. Linear Independence}

Vectors $\mathbf{v}_1,\ldots,\mathbf{v}_k$ are linearly independent if

\[
c_1\mathbf{v}_1+\cdots+c_k\mathbf{v}_k=\mathbf{0}
\]

has only the trivial solution

\[
c_1=c_2=\cdots=c_k=0.
\]

\begin{itemize}
    \item Independent vectors contain no redundant direction.
    \item If one vector can be expressed using the others, the set is
    linearly dependent.
    \item A basis must always be linearly independent.
\end{itemize}

\begin{exampleblock}{Example}
\[
\begin{bmatrix}1\\0\end{bmatrix},
\quad
\begin{bmatrix}0\\1\end{bmatrix}
\]

are linearly independent.
\end{exampleblock}

\end{frame}

% =================================================
% MATRICES
% =================================================

\section{Matrices and Linear Transformations}

% -------------------------------------------------
\begin{frame}[t,shrink=12]{9. Matrix Multiplication}

For matrices $A$ and $B$, the product $AB$ is defined when

\[
\text{number of columns of }A
=
\text{number of rows of }B.
\]

If

\[
A\in\mathbb{R}^{m\times n},
\qquad
B\in\mathbb{R}^{n\times p},
\]

then

\[
AB\in\mathbb{R}^{m\times p}.
\]

The $(i,j)$ entry is

\[
(AB)_{ij}
=
\sum_{k=1}^{n}a_{ik}b_{kj}.
\]

\begin{block}{Important}
Matrix multiplication is generally \textbf{not commutative}:

\[
AB\neq BA.
\]
\end{block}

\end{frame}

% -------------------------------------------------
\begin{frame}[t,shrink=12]{10. Matrix Multiplication as Composition}

A matrix can represent a linear transformation.

Suppose

\[
T_1(\mathbf{x})=A\mathbf{x}
\]

and

\[
T_2(\mathbf{x})=B\mathbf{x}.
\]

Applying $T_1$ followed by $T_2$ gives

\[
T_2(T_1(\mathbf{x}))
=
B(A\mathbf{x})
=
(BA)\mathbf{x}.
\]

Thus matrix multiplication represents the
\textbf{composition of linear transformations}.

\begin{block}{Interpretation}
\[
\boxed{\text{Transformation 1}
\longrightarrow
\text{Transformation 2}
\longrightarrow
\text{Combined transformation}}
\]
\end{block}

The order of multiplication is therefore important.

\end{frame}

% -------------------------------------------------
\begin{frame}[t,shrink=12]{11. Three-Dimensional Linear Transformations}

A linear transformation maps vectors from one vector space to another
while preserving vector addition and scalar multiplication.

\[
T(\mathbf{u}+\mathbf{v})
=
T(\mathbf{u})+T(\mathbf{v})
\]

and

\[
T(c\mathbf{u})
=
cT(\mathbf{u}).
\]

In $\mathbb{R}^3$,

\[
T(\mathbf{x})=A\mathbf{x},
\qquad
A\in\mathbb{R}^{3\times3}.
\]

Common transformations include:

\begin{itemize}
    \item Rotation
    \item Reflection
    \item Scaling
    \item Shearing
\end{itemize}

\end{frame}

% -------------------------------------------------
\begin{frame}[t,shrink=15]{12. Examples of 3D Linear Transformations}

A scaling transformation can be represented by

\[
A=
\begin{bmatrix}
s_x&0&0\\
0&s_y&0\\
0&0&s_z
\end{bmatrix}.
\]

Then

\[
\begin{bmatrix}
x'\\y'\\z'
\end{bmatrix}
=
A
\begin{bmatrix}
x\\y\\z
\end{bmatrix}.
\]

For a rotation about the $z$-axis,

\[
R_z(\theta)=
\begin{bmatrix}
\cos\theta&-\sin\theta&0\\
\sin\theta&\cos\theta&0\\
0&0&1
\end{bmatrix}.
\]

\begin{block}{Applications}
3D transformations are fundamental in:
\begin{itemize}
    \item Computer graphics
    \item Computer vision
    \item Robotics
    \item Game development
\end{itemize}
\end{block}

\end{frame}

% =================================================
% DETERMINANT AND INVERSE
% =================================================

\section{Determinants and Inverse Matrices}

% -------------------------------------------------
\begin{frame}[t,shrink=12]{13. Determinant}

The \textbf{determinant} is a scalar value associated with a square matrix.

For

\[
A=
\begin{bmatrix}
a&b\\
c&d
\end{bmatrix},
\]

the determinant is

\[
\det(A)=ad-bc.
\]

\begin{block}{Geometric Meaning}
The absolute value of the determinant represents the factor by which
a linear transformation changes area or volume.
\end{block}

\begin{itemize}
    \item $\det(A)>0$: orientation is preserved.
    \item $\det(A)<0$: orientation is reversed.
    \item $\det(A)=0$: space is collapsed into a lower dimension.
\end{itemize}

\end{frame}

% -------------------------------------------------
\begin{frame}[t,shrink=12]{14. Determinant of a $3\times3$ Matrix}

For

\[
A=
\begin{bmatrix}
a&b&c\\
d&e&f\\
g&h&i
\end{bmatrix},
\]

the determinant is

\[
\det(A)
=
a(ei-fh)
-b(di-fg)
+c(dh-eg).
\]

\begin{block}{Properties}
\begin{itemize}
    \item $\det(AB)=\det(A)\det(B)$.
    \item $\det(A^T)=\det(A)$.
    \item If two rows are interchanged, the sign changes.
    \item A matrix is singular if $\det(A)=0$.
\end{itemize}
\end{block}

\end{frame}

% -------------------------------------------------
\begin{frame}[t,shrink=12]{15. Inverse Matrix}

For a square matrix $A$, its inverse $A^{-1}$ satisfies

\[
AA^{-1}=A^{-1}A=I.
\]

The inverse exists only when

\[
\det(A)\neq0.
\]

For

\[
A=
\begin{bmatrix}
a&b\\
c&d
\end{bmatrix},
\]

\[
A^{-1}
=
\frac{1}{ad-bc}
\begin{bmatrix}
d&-b\\
-c&a
\end{bmatrix}.
\]

\begin{block}{Application}
The inverse matrix is useful for solving systems:

\[
A\mathbf{x}=\mathbf{b}
\]

giving

\[
\mathbf{x}=A^{-1}\mathbf{b}.
\]
\end{block}

\end{frame}

