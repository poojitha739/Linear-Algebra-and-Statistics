% EIGENVALUES AND EIGENVECTORS
% =================================================

\section{Eigenvalues and Eigenvectors}

% -------------------------------------------------
\begin{frame}[t,shrink=12]{31. Eigenvectors}

A non-zero vector $\mathbf{v}$ is an \textbf{eigenvector} of matrix
$A$ if

\[
A\mathbf{v}
=
\lambda\mathbf{v}.
\]

Here $\lambda$ is a scalar called the eigenvalue.

\begin{block}{Interpretation}
An eigenvector is a direction that does not change direction when the
linear transformation $A$ is applied to it.

Only its magnitude and possibly its orientation may change.
\end{block}

\[
A\mathbf{v}
=
\lambda\mathbf{v}.
\]

\end{frame}

% -------------------------------------------------
\begin{frame}[t,shrink=12]{32. Eigenvalues}

From

\[
A\mathbf{v}
=
\lambda\mathbf{v},
\]

we obtain

\[
A\mathbf{v}-\lambda\mathbf{v}
=
\mathbf{0}.
\]

Therefore,

\[
(A-\lambda I)\mathbf{v}
=
\mathbf{0}.
\]

For a non-zero solution,

\[
\boxed{
\det(A-\lambda I)=0
}
\]

This equation is called the \textbf{characteristic equation}.

Its roots are the eigenvalues of $A$.

\end{frame}

% -------------------------------------------------
\begin{frame}[t,shrink=12]{33. Finding Eigenvectors}

After finding an eigenvalue $\lambda$, substitute it into

\[
(A-\lambda I)\mathbf{v}=0.
\]

Then solve the resulting homogeneous system.

\begin{enumerate}
    \item Find $\det(A-\lambda I)$.
    \item Solve the characteristic equation.
    \item Obtain the eigenvalues $\lambda_1,\lambda_2,\ldots$.
    \item For each eigenvalue, solve
    \[
    (A-\lambda I)\mathbf{v}=0.
    \]
    \item The non-zero solutions are eigenvectors.
\end{enumerate}

\end{frame}

% -------------------------------------------------
\begin{frame}[t,shrink=12]{34. Example: Eigenvalues and Eigenvectors}

Consider

\[
A=
\begin{bmatrix}
2&0\\
0&3
\end{bmatrix}.
\]

The characteristic equation is

\[
\det
\begin{bmatrix}
2-\lambda&0\\
0&3-\lambda
\end{bmatrix}
=0.
\]

Therefore,

\[
(2-\lambda)(3-\lambda)=0.
\]

Hence,

\[
\lambda_1=2,
\qquad
\lambda_2=3.
\]

Corresponding eigenvectors are

\[
\mathbf{v}_1=
\begin{bmatrix}
1\\0
\end{bmatrix},
\qquad
\mathbf{v}_2=
\begin{bmatrix}
0\\1
\end{bmatrix}.
\]

\end{frame}

