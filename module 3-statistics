% 9
% ============================================================
\begin{frame}{2. Histogram: Definition and Purpose}
\begin{itemize}
\item A histogram is a graphical representation of the distribution of
a quantitative variable.
\item The numerical range is divided into \textbf{bins} or intervals.
\item The height represents frequency, relative frequency or density.
\item Unlike a bar chart, histogram bars represent adjacent numerical intervals.
\end{itemize}
\[
\text{Data}\rightarrow\text{Bins}\rightarrow
\text{Frequencies/Densities}\rightarrow\text{Histogram}
\]
Uses include detecting center, spread, skewness, modality and unusual values.
\end{frame}

% ============================================================
% 10
% ============================================================
\begin{frame}{Construction of a Histogram}
For observations $x_1,\ldots,x_n$:
\begin{enumerate}
\item Find the minimum and maximum.
\item Choose the number of bins or bin width.
\item Define non-overlapping intervals.
\item Count observations in each interval.
\item Plot the counts/densities against the intervals.
\end{enumerate}
If bin width is $h$ and a bin contains $f_j$ observations,
its density can be written as
\[
\hat f_j=\frac{f_j}{nh}.
\]
This makes histogram area approximately sum to one.
\end{frame}

% ============================================================
% 11
% ============================================================
\begin{frame}{Histogram: Frequency and Density}
\begin{itemize}
\item \textbf{Frequency}: number of observations in a bin.
\item \textbf{Relative frequency}: $f_j/n$.
\item \textbf{Density}: relative frequency divided by bin width.
\end{itemize}
For equal-width bins:
\[
\text{density}=\frac{\text{frequency}}{n\times\text{bin width}}.
\]
For unequal-width bins, bar \textbf{area}, rather than height alone,
must represent probability.
\important{A density histogram has total area approximately equal to 1.}
\end{frame}

% ============================================================
% 12
% ============================================================
\begin{frame}{Histogram: Worked Example}
Consider:
\[
12,\;15,\;17,\;18,\;19,\;21,\;22,\;23,\;25,\;28.
\]
Take bins of width $5$:
\[
[10,15),\ [15,20),\ [20,25),\ [25,30].
\]
Corresponding frequencies:
\[
\begin{array}{c|c}
\text{Bin}&\text{Frequency}\\\hline
10-15&1\\
15-20&4\\
20-25&3\\
25-30&2
\end{array}
\]
The histogram immediately shows that observations concentrate around
the middle intervals.
\end{frame}

% ============================================================
% 13
% ============================================================
\begin{frame}{Interpreting Histogram Shape}
Common patterns:
\begin{itemize}
\item \textbf{Symmetric}: left and right sides are approximately balanced.
\item \textbf{Right-skewed}: long tail toward larger values.
\item \textbf{Left-skewed}: long tail toward smaller values.
\item \textbf{Bimodal}: two prominent peaks.
\item \textbf{Uniform-like}: relatively even frequencies.
\item \textbf{Heavy-tailed}: unusually large probability in the tails.
\end{itemize}
A histogram is exploratory evidence, not proof of a particular distribution.
\end{frame}

